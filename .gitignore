# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Real data stays outside Git
data/raw/
data/restricted/

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Snakemake runtime state, logs, and generated outputs
.snakemake/
logs/
results/*
!results/.gitkeep

# Editors / operating systems
.DS_Store
.idea/
.vscode/
*.swp

/.codebase-memory/
